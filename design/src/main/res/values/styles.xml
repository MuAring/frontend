<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 버튼 -->
    <style name="Widget.Muaring.Button.Primary" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/brand_primary</item>
        <item name="android:minHeight">@dimen/space_48</item>
        <item name="android:insetLeft">@dimen/space_16</item>
        <item name="android:insetRight">@dimen/space_16</item>
        <item name="shapeAppearance">@style/Shape.Medium</item>
        <item name="android:textAppearance">@style/Type.Title</item>
    </style>


    <!-- nav바 관련 스타일 -->
    <style name="Widget.Muaring.BottomNav" parent="Widget.Material3.BottomNavigationView">
        <item name="itemActiveIndicatorStyle">@style/BottomNavIndicatorGone</item>
    </style>

    <style name="BottomNavIndicatorGone" parent="">
        <item name="android:width">0dp</item>
        <item name="android:height">0dp</item>
        <item name="android:color">@android:color/transparent</item>
    </style>


    <!-- 🔎 검색창 스타일-->
    <!-- 공통 세그먼트 버튼 스타일 -->
    <style name="Widget.Muaring.SegmentedButton" parent="@style/Widget.AppCompat.Button">
        <item name="android:minHeight">0dp</item>
        <item name="android:paddingLeft">24dp</item>
        <item name="android:paddingRight">24dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:backgroundTint">@android:color/transparent</item>
    </style>

    <!-- 왼쪽 버튼 (그룹) -->
    <style name="Widget.Muaring.SegmentedButton.Left" parent="Widget.Muaring.SegmentedButton">
        <item name="android:background">@drawable/bg_segment_selected</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <!-- 오른쪽 버튼 (사용자) -->
    <style name="Widget.Muaring.SegmentedButton.Right" parent="Widget.Muaring.SegmentedButton">
        <item name="android:background">@drawable/bg_segment_unselected</item>
        <item name="android:textColor">@color/black</item>
    </style>

    <!-- 검색창 -->
    <!-- TextInputLayout 검색용 스타일 -->
    <style name="Widget.Muaring.TextInputLayout.Search" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/search_input_outline</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="hintTextColor">@color/placeholder</item>
        <item name="android:textColorHint">@color/placeholder</item>
        <item name="boxBackgroundColor">@color/surface</item>
    </style>

    <!-- TextInputEditText 아웃라인 스타일 -->
    <style name="Widget.Muaring.TextInputEditText.Outlined" parent="Widget.MaterialComponents.TextInputEditText.OutlinedBox">
        <item name="android:textColor">@color/black</item>
        <item name="android:textSize">16sp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
    </style>





    <!-- 텍스트 -->
    <style name="Text.Muaring.Title" parent="">
        <item name="android:textColor">@color/on_surface</item>
        <item name="android:textSize">18sp</item>
        <item name="fontFamily">@font/pretendard_semibold</item>
    </style>
    <style name="Text.Muaring.Body" parent="">
        <item name="android:textColor">@color/on_surface</item>
        <item name="android:textSize">16sp</item>
        <item name="fontFamily">@font/pretendard_regular</item>
    </style>

    <!-- shape 정의 -->
    <style name="Shape.Small">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">8dp</item>
    </style>
    <style name="Shape.Medium">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>
    <style name="Shape.Large">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>
    <style name="Shape" parent="Shape.Medium"/>


</resources>

