<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mapFragment"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <include
        android:id="@+id/toolbar"
        layout="@layout/toolbar_common"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.kakao.vectormap.MapView
        android:id="@+id/map_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

<!--    핀버튼-->
    <FrameLayout
        android:id="@+id/btnContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="350dp">

    <ImageButton
            android:id="@+id/btnShowMusic"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:src="@drawable/pin_button"
            android:background="@android:color/transparent"
            />

        <TextView
            android:id="@+id/tvCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:textSize="24sp"
            android:gravity="center"
            android:layout_gravity="center"/>
    </FrameLayout>
    
    <ImageView
        android:id="@+id/imageNearby"
        android:layout_width="236dp"
        android:layout_height="109dp"
        android:src="@drawable/nearby_search"
        app:layout_constraintTop_toBottomOf="@id/btnContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="10dp"
        />


<!--    프레임-->
    <androidx.cardview.widget.CardView
        android:id="@+id/musicCard"
        android:layout_width="290dp"
        android:layout_height="296dp"
        android:elevation="6dp"
        android:visibility="invisible"
        app:cardCornerRadius="10dp"
        app:layout_constraintTop_toBottomOf="@id/btnContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="10dp"
        >

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            >

<!--            제목-->
            <TextView
                android:id="@+id/textTodayMusic"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="오늘의 음악"
                android:textSize="13sp"
                android:textStyle="bold"
                android:paddingVertical="10dp"
                android:gravity="center"
                />

        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvMusic"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="40dp"/>
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>