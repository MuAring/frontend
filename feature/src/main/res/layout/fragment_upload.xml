<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/uploadFragment"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <include
        android:id="@+id/toolbar"
        layout="@layout/toolbar_common"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <include
        android:id="@+id/selectedMusic"
        layout="@layout/item_library_music"
        android:layout_width="304dp"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="35dp"/>

    <TextView
        android:id="@+id/text1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="함께 공유할 그룹을 선택해주세요"
        android:fontFamily="@font/pretendard_medium"
        android:textColor="@color/dark_green"
        android:textSize="14dp"
        app:layout_constraintTop_toBottomOf="@id/selectedMusic"
        app:layout_constraintStart_toStartOf="@id/selectedMusic"
        android:layout_marginTop="50dp"
        android:layout_marginLeft="2dp"
        />

    <Spinner
        android:id="@+id/spinnerGroup"
        android:layout_width="144dp"
        android:layout_height="36dp"
        android:background="@drawable/bg_spinner_dropdown"
        android:gravity="center_vertical"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        app:layout_constraintTop_toBottomOf="@id/text1"
        app:layout_constraintStart_toStartOf="@id/selectedMusic"
        android:layout_marginTop="5dp"/>

    <TextView
        android:id="@+id/text2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="음악과 함께 오늘의 이야기를 남겨보세요"
        android:fontFamily="@font/pretendard_medium"
        android:textColor="@color/dark_green"
        android:textSize="14dp"
        app:layout_constraintTop_toBottomOf="@id/spinnerGroup"
        app:layout_constraintStart_toStartOf="@id/selectedMusic"
        android:layout_marginTop="60dp"
        android:layout_marginLeft="2dp"/>

    <EditText
        android:id="@+id/edtText"
        android:layout_width="304dp"
        android:layout_height="180dp"
        android:background="@drawable/bg_input_box"
        android:paddingVertical="12dp"
        android:paddingHorizontal="15dp"
        android:gravity="top|start"
        android:fontFamily="@font/pretendard_medium"
        android:textSize="12sp"
        app:layout_constraintStart_toStartOf="@id/selectedMusic"
        app:layout_constraintTop_toBottomOf="@id/text2"
        android:layout_marginTop="5dp"
        />

    <Button
        android:id="@+id/btnPost"
        android:layout_width="110dp"
        android:layout_height="40dp"
        android:text="등록하기"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:background="@drawable/bg_button_green"
        android:fontFamily="@font/pretendard_medium"
        app:layout_constraintTop_toBottomOf="@id/edtText"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="80dp"/>

</androidx.constraintlayout.widget.ConstraintLayout>