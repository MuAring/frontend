<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_marginTop="55dp">

    <!--    보관함 타이틀-->
    <include
        android:id="@+id/include_toolbar_group"
        layout="@layout/toolbar_common"
        app:layout_constraintTop_toTopOf="parent"/>

    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/include_toolbar_group"
        android:orientation="horizontal"
        android:paddingTop="30dp"
        android:paddingBottom="6dp">

        <TextView
            android:id="@+id/tvTotalCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingLeft="38dp"
            android:text="전체 음악 개수"
            android:textSize="15sp"
            android:textColor="@color/black"
            android:fontFamily="@font/pretendard_medium" />

        <TextView
            android:id="@+id/btnSelectAll"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="전체 선택"
            android:textSize="12sp"
            android:textColor="@color/black"
            android:fontFamily="@font/pretendard_medium"
            android:paddingHorizontal="4dp"
            android:clickable="true"
            android:focusable="true"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="|"
            android:textSize="12sp"
            android:textColor="@color/black"
            android:fontFamily="@font/pretendard_medium"/>

        <TextView
            android:id="@+id/btnClearSelect"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="선택 해제"
            android:textSize="12sp"
            android:textColor="@color/black"
            android:fontFamily="@font/pretendard_medium"
            android:background="@android:color/transparent"
            android:layout_marginRight="38dp"
            android:paddingHorizontal="4dp"
            android:clickable="true"
            android:focusable="true"/>

    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvArchiveMusic"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_gravity="center_horizontal"
        android:paddingBottom="6dp"
        app:layout_constraintTop_toBottomOf="@id/header"
        app:layout_constraintBottom_toBottomOf="parent"/>

    <LinearLayout
        android:id="@+id/bottomActionBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp"
        android:paddingHorizontal="18dp"
        android:elevation="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:visibility="gone">

        <!-- Spotify 버튼 -->
        <ImageView
            android:id="@+id/btnSpotify"
            android:layout_width="161dp"
            android:layout_height="42dp"
            android:src="@drawable/ic_spotify" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"/>

        <!-- 삭제 버튼 -->
        <ImageView
            android:id="@+id/btnDelete"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:src="@drawable/ic_delete" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>