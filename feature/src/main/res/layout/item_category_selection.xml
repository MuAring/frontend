<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="카테고리"
        android:textSize="16sp"
        android:textColor="#000000"
        android:layout_marginBottom="5dp"/>

    <!-- 첫 번째 줄 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btn_pop"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:text="POP"
            android:textSize="14sp"
            android:textColor="#666666"
            android:gravity="center"
            android:background="@drawable/category_button_outline"
            android:clickable="true"
            android:focusable="true"/>

        <TextView
            android:id="@+id/btn_kpop"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:text="K-POP"
            android:textSize="14sp"
            android:textColor="#666666"
            android:gravity="center"
            android:background="@drawable/category_button_outline"
            android:clickable="true"
            android:focusable="true"/>

        <TextView
            android:id="@+id/btn_hiphop"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:text="힙합/랩"
            android:textSize="14sp"
            android:textColor="#666666"
            android:gravity="center"
            android:background="@drawable/category_button_outline"
            android:clickable="true"
            android:focusable="true"/>

        <TextView
            android:id="@+id/btn_rnb"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:text="R&amp;B"
            android:textSize="14sp"
            android:textColor="#666666"
            android:gravity="center"
            android:background="@drawable/category_button_outline"
            android:clickable="true"
            android:focusable="true"/>
    </LinearLayout>

    <!-- 두 번째 줄 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btn_rock"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:text="락"
            android:textSize="14sp"
            android:textColor="#666666"
            android:gravity="center"
            android:background="@drawable/category_button_outline"
            android:clickable="true"
            android:focusable="true"/>

        <TextView
            android:id="@+id/btn_indie"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:text="인디"
            android:textSize="14sp"
            android:textColor="#666666"
            android:gravity="center"
            android:background="@drawable/category_button_outline"
            android:clickable="true"
            android:focusable="true"/>

        <TextView
            android:id="@+id/btn_edm"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:text="EDM"
            android:textSize="14sp"
            android:textColor="#666666"
            android:gravity="center"
            android:background="@drawable/category_button_outline"
            android:clickable="true"
            android:focusable="true"/>

        <TextView
            android:id="@+id/btn_ballad"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:text="발라드"
            android:textSize="14sp"
            android:textColor="#666666"
            android:gravity="center"
            android:background="@drawable/category_button_outline"
            android:clickable="true"
            android:focusable="true"/>
    </LinearLayout>

    <!-- 세 번째 줄 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btn_jazz"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:text="재즈"
            android:textSize="14sp"
            android:textColor="#666666"
            android:gravity="center"
            android:background="@drawable/category_button_outline"
            android:clickable="true"
            android:focusable="true"/>

        <TextView
            android:id="@+id/btn_metal"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:text="메탈"
            android:textSize="14sp"
            android:textColor="#666666"
            android:gravity="center"
            android:background="@drawable/category_button_outline"
            android:clickable="true"
            android:focusable="true"/>

        <TextView
            android:id="@+id/btn_latin"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:text="라틴"
            android:textSize="14sp"
            android:textColor="#666666"
            android:gravity="center"
            android:background="@drawable/category_button_outline"
            android:clickable="true"
            android:focusable="true"/>

        <TextView
            android:id="@+id/btn_classic"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:text="클래식"
            android:textSize="14sp"
            android:textColor="#666666"
            android:gravity="center"
            android:background="@drawable/category_button_outline"
            android:clickable="true"
            android:focusable="true"/>
    </LinearLayout>

    <!-- 네 번째 줄 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btn_ost"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:text="OST"
            android:textSize="14sp"
            android:textColor="#666666"
            android:gravity="center"
            android:background="@drawable/category_button_outline"
            android:clickable="true"
            android:focusable="true"/>

        <TextView
            android:id="@+id/btn_national"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:text="국힙"
            android:textSize="14sp"
            android:textColor="#666666"
            android:gravity="center"
            android:background="@drawable/category_button_outline"
            android:clickable="true"
            android:focusable="true"/>

        <TextView
            android:id="@+id/btn_jpop"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:text="J-POP"
            android:textSize="14sp"
            android:textColor="#666666"
            android:gravity="center"
            android:background="@drawable/category_button_outline"
            android:clickable="true"
            android:focusable="true"/>

        <TextView
            android:id="@+id/btn_guitar"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:text="기타"
            android:textSize="14sp"
            android:textColor="#666666"
            android:gravity="center"
            android:background="@drawable/category_button_outline"
            android:clickable="true"
            android:focusable="true"/>
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="최대 3개까지 선택 가능합니다."
        android:textSize="12sp"
        android:textColor="#888888"
        android:layout_marginTop="4dp"/>

</LinearLayout>