<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:background="@color/white"
    android:padding="24dp">

    <!-- 상단 여백 -->
    <Space
        android:layout_width="match_parent"
        android:layout_height="76dp"/>

    <!-- 프로필 이미지와 체크 아이콘 컨테이너 -->
    <FrameLayout
        android:layout_width="150dp"
        android:layout_height="150dp">

        <!-- 프로필 이미지 (기본은 ic_group_default, 업로드하면 변경됨) -->
        <ImageView
            android:id="@+id/iv_profile_image"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:background="@drawable/circle_background_grey"
            android:src="@drawable/ic_group_default"
            android:scaleType="centerInside"
            android:padding="10dp"
            android:clipToOutline="true"/>

        <!-- 체크 아이콘 -->
        <ImageView
            android:id="@+id/iv_checkmark"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_check_circle"
            android:layout_gravity="end|bottom"
            android:layout_marginEnd="0dp"
            android:layout_marginBottom="0dp"/>
    </FrameLayout>

    <!-- 그룹 생성 완료 텍스트 -->
    <TextView
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="그룹 생성이 완료되었습니다."
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#000000"/>

    <!-- 설명 텍스트 -->
    <TextView
        android:id="@+id/tv_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="오늘의 음악을 올려 첫 게시물을 남겨보세요."
        android:textSize="14sp"
        android:textColor="#666666"/>

    <!-- 홈으로 버튼 -->
    <Button
        android:id="@+id/btn_go_home"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="48dp"
        android:text="홈으로"
        android:textSize="16sp"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:background="@drawable/button_primary_background"/>

    <!-- 또는 구분선 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="32dp"
        android:gravity="center_vertical">

        <View
            android:id="@+id/divider_left"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"
            android:layout_marginEnd="16dp"
            android:background="#E0E0E0"/>

        <TextView
            android:id="@+id/tv_or"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="또는"
            android:textSize="14sp"
            android:textColor="#666666"/>

        <View
            android:id="@+id/divider_right"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"
            android:layout_marginStart="16dp"
            android:background="#E0E0E0"/>
    </LinearLayout>

    <!-- 친구 초대하기 버튼 -->
    <Button
        android:id="@+id/btn_invite_friend"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="24dp"
        android:text="친구 초대하기"
        android:textSize="16sp"
        android:textColor="@color/green"
        android:textStyle="bold"
        android:background="@drawable/bg_button_outline_green"/>

    <!-- 초대 링크 복사 버튼 -->
    <Button
        android:id="@+id/btn_copy_link"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="12dp"
        android:text="초대 링크 복사"
        android:textSize="16sp"
        android:textColor="#666666"
        android:background="@drawable/bg_button_outline_gray"/>

</LinearLayout>