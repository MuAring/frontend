<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/muaringTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Muaring"
        android:textSize="48sp"
        android:textStyle="bold"
        android:layout_gravity="center_horizontal"
        android:textColor="@color/dark_green"
        android:layout_marginTop="120dp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:layout_marginBottom="60dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnKakaoLogin"
            android:layout_width="204dp"
            android:layout_height="60dp"
            android:text="카카오 로그인"
            android:backgroundTint="@color/kakao_yellow"
            android:textColor="@color/kakao_black"
            style="@style/Widget.MaterialComponents.Button"
            app:cornerRadius="12dp"
            app:rippleColor="@android:color/transparent"
            android:stateListAnimator="@null"

            android:layout_marginBottom="1dp"
            />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSpotifyLogin"
            android:layout_width="204dp"
            android:layout_height="60dp"
            android:text="스포티파이 로그인"
            android:backgroundTint="@color/spotify_black"
            android:textColor="@color/spotify_green"
            style="@style/Widget.MaterialComponents.Button"
            app:cornerRadius="12dp"
            app:rippleColor="@android:color/transparent"
            android:stateListAnimator="@null"
            />
    </LinearLayout>
</LinearLayout>